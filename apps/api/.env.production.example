# Production Environment Configuration Example
# Copy this file to .env.production and populate with real values

# Server
NODE_ENV=production
PORT=3000

# Database
# Use a production-grade MongoDB cluster (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Authentication
# Must be at least 32 characters, random string
JWT_SECRET=your_production_jwt_secret_here

# AI Services
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional/External Integrations (eGot, NSSTA)
# IGOT_API_URL=https://api.igot.karmayogi.gov.in
# IGOT_API_KEY=

