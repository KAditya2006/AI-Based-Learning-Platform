# ==========================================
# PRODUCTION CONFIGURATION GOVERNANCE
# ==========================================
# WARNING: DO NOT COMMIT REAL VALUES TO THIS FILE.
# This file serves as the strict template for the environment schema.

# ------------------------------------------
# SERVER & DEPLOYMENT
# ------------------------------------------
# (Required) Determines execution mode: 'development', 'production', or 'test'
NODE_ENV=production
# (Required) Application port inside the container
PORT=3000
# (Optional) Log level (error, warn, info, debug). Defaults to 'info' in production.
LOG_LEVEL=info

# ------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------
# (Required) Full MongoDB connection string. MUST use secure credentials in production.
MONGODB_URI=mongodb://user:pass@host:27017/mospi_skill_platform?authSource=admin

# ------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------
# (Required) Secret key for JWT signing. Must be at least 64 characters of high entropy.
JWT_SECRET=
# (Optional) JWT expiration time. Default is '24h'.
JWT_EXPIRES_IN=24h
# (Optional) Allowed CORS origin. Critical for production security.
CORS_ORIGIN=https://learning.mospi.gov.in

# ------------------------------------------
# AI GOVERNANCE & INTEGRATION
# ------------------------------------------
# (Required) Selected AI Provider. Use 'mock' for local dev, 'gemini' for prod.
AI_PROVIDER=gemini
# (Required if AI_PROVIDER=gemini) Valid API Key for Google Gemini.
GEMINI_API_KEY=
# (Optional) Specific model version. Default: gemini-2.5-flash
AI_MODEL=gemini-2.5-flash
# (Optional) Timeout in ms to prevent hanging requests.
AI_TIMEOUT=30000

# ------------------------------------------
# EXTERNAL INTEGRATION CONTROL PLANE
# ------------------------------------------
# (Required) Enable iGOT provider sync? (true/false)
IGOT_ENABLED=false
IGOT_BASE_URL=https://api.igot.gov.in
IGOT_API_KEY=

# (Required) Enable NSSTA provider sync? (true/false)
NSSTA_ENABLED=false
NSSTA_BASE_URL=https://api.nssta.gov.in
NSSTA_API_KEY=
